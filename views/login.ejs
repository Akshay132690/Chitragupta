<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Environmental Access</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <style>
        :root {
            --glacier-blue: #a0c4e4;
            --deep-blue: #2a6f97;
            --water-teal: #008b8b;
            --mountain-gray: #4a5568;
            --ice-white: #f0f9ff;
        }

        body {
            background: linear-gradient(135deg,
                    #2a6f97 0%,
                    /* Deep glacier blue */
                    #468faf 25%,
                    /* Medium glacier blue */
                    #89c2d9 50%,
                    /* Light glacier blue */
                    #a0c4e4 75%,
                    /* Ice blue */
                    #f0f9ff 100%
                    /* Snow white */
                );
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
        }

        @keyframes gradientShift {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .glacier-card {
            background: rgba(240, 249, 255, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(160, 196, 228, 0.3);
            box-shadow:
                0 25px 50px -12px rgba(42, 111, 151, 0.25),
                0 0 0 1px rgba(160, 196, 228, 0.1);
        }

        .glacier-button {
            background: linear-gradient(135deg, #2a6f97, #468faf);
            border: 2px solid transparent;
            background-clip: padding-box;
            position: relative;
            overflow: hidden;
            transform: translateY(0);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glacier-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.6s;
        }

        .glacier-button:hover::before {
            left: 100%;
        }

        .glacier-button:hover {
            transform: translateY(-2px);
            box-shadow:
                0 20px 40px -8px rgba(42, 111, 151, 0.3),
                0 0 20px rgba(160, 196, 228, 0.4);
            background: linear-gradient(135deg, #468faf, #89c2d9);
        }

        .nav-link {
            color: var(--deep-blue);
            transition: all 0.3s ease;
            position: relative;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 50%;
            background: linear-gradient(90deg, #2a6f97, #89c2d9);
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }

        .nav-link:hover {
            color: var(--water-teal);
            transform: translateY(-1px);
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .logout-link {
            color: #dc2626;
            transition: all 0.3s ease;
        }

        .logout-link:hover {
            color: #ef4444;
            transform: translateY(-1px);
        }

        .glacier-title {
            background: linear-gradient(135deg, #2a6f97, #468faf, #89c2d9);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: titleGlow 3s ease-in-out infinite alternate;
        }

        @keyframes titleGlow {
            0% {
                filter: brightness(1);
            }

            100% {
                filter: brightness(1.2);
            }
        }

        .water-icon {
            display: inline-block;
            animation: waterRipple 4s ease-in-out infinite;
        }

        @keyframes waterRipple {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.1);
            }
        }

        .scroll-reveal {
            opacity: 0;
            transform: translateY(30px);
            animation: revealUp 0.8s ease forwards;
        }

        @keyframes revealUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .professional-shadow {
            box-shadow:
                0 4px 20px rgba(42, 111, 151, 0.1),
                0 1px 3px rgba(42, 111, 151, 0.08);
        }

        .location-selector {
            transition: all 0.3s ease;
            border: 1px solid #a0c4e4;
        }

        .location-selector:focus {
            border-color: #2a6f97;
            box-shadow: 0 0 0 2px rgba(42, 111, 151, 0.2);
        }

        .location-display {
            background: rgba(160, 196, 228, 0.2);
            border-left: 3px solid #2a6f97;
            padding: 8px 12px;
            border-radius: 4px;
            margin-top: 8px;
            font-size: 0.9rem;
        }
    </style>
</head>

<body class="flex items-center justify-center min-h-screen p-4">
    <div class="glacier-card p-12 rounded-3xl max-w-md w-full text-center scroll-reveal professional-shadow">
        <div class="mb-8">
            <img src="we.png" alt="ChitraGupta" class="w-[150px] h-[150px] object-contain rounded-lg"
                onerror="this.src='placeholder.png'; this.onerror=null;">
            <br>
            <p class="text-gray-600 text-sm font-medium">Glacial,Road Networks & Drainage Monitoring System</p>
        </div>



        <div class="space-y-4 mb-6">
            <a href="/auth/google"
                class="glacier-button text-white px-8 py-4 rounded-full font-semibold text-lg inline-block w-full">
                Continue with Google
            </a>

            <!-- <button id="detectLocationBtn"
                class="w-full px-8 py-4 rounded-full font-semibold text-lg border-2 border-blue-500 text-blue-600 hover:bg-blue-50 transition-all">
                Detect My Location
            </button> -->
        </div>

        <div class="flex justify-between items-center text-sm font-medium">
            <a href="/" class="nav-link flex items-center gap-1">
                ← Back to Home
            </a>
            <a href="/logout" class="logout-link hover:underline">
                Logout 🚪
            </a>
        </div>

        <div class="mt-8 pt-6 border-t border-gray-200">
            <p class="text-xs text-gray-500 flex items-center justify-center gap-2">
                <span>🧊</span>
                <span>Monitoring environmental changes</span>
                <span>🌐</span>
            </p>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Animate elements on page load
            const elements = document.querySelectorAll('.scroll-reveal');
            elements.forEach((el, index) => {
                el.style.animationDelay = `${index * 0.2}s`;
            });

            // Location selection logic
            const locationSelect = document.getElementById('location');
            const customCoords = document.getElementById('custom-coords');
            const detectedLocationInfo = document.getElementById('detectedLocationInfo');

            // Check if we have a saved location
            if (localStorage.getItem('monitoringLocation') === 'detected') {
                locationSelect.value = 'detected';
                displayDetectedLocation();
            } else if (localStorage.getItem('monitoringLocation') === 'custom') {
                locationSelect.value = 'custom';
                customCoords.classList.remove('hidden');
                try {
                    const coords = JSON.parse(localStorage.getItem('customCoordinates'));
                    if (coords) {
                        customCoords.querySelectorAll('input')[0].value = coords.latitude || '';
                        customCoords.querySelectorAll('input')[1].value = coords.longitude || '';
                    }
                } catch (e) {
                    console.error('Error parsing custom coordinates:', e);
                }
            }

            locationSelect.addEventListener('change', function () {
                if (this.value === 'custom') {
                    customCoords.classList.remove('hidden');
                    detectedLocationInfo.classList.add('hidden');
                } else if (this.value === 'detected') {
                    customCoords.classList.add('hidden');
                    displayDetectedLocation();
                } else {
                    customCoords.classList.add('hidden');
                    detectedLocationInfo.classList.add('hidden');
                }

                // Save to localStorage
                localStorage.setItem('monitoringLocation', this.value);
            });

            

            // Create floating environmental particles
            createFloatingParticles();
        });

        function createFloatingParticles() {
            const colors = ['#a0c4e4', '#2a6f97', '#008b8b', '#89c2d9'];
            const symbols = ['🧊', '❄️', '🌊', '💧', '🏔️'];

            setInterval(() => {
                if (Math.random() > 0.7) {
                    const particle = document.createElement('div');
                    particle.style.cssText = `
                        position: fixed;
                        pointer-events: none;
                        z-index: -1;
                        font-size: ${Math.random() * 20 + 10}px;
                        left: ${Math.random() * 100}vw;
                        top: 100vh;
                        color: ${colors[Math.floor(Math.random() * colors.length)]};
                        animation: floatUp ${Math.random() * 3 + 4}s linear forwards;
                        opacity: 0.6;
                    `;
                    particle.textContent = symbols[Math.floor(Math.random() * symbols.length)];
                    document.body.appendChild(particle);

                    particle.addEventListener('animationend', () => {
                        particle.remove();
                    });
                }
            }, 2000);
        }

        // Add CSS for floating animation
        const style = document.createElement('style');
        style.textContent = `
            @keyframes floatUp {
                0% {
                    transform: translateY(0) rotate(0deg);
                    opacity: 0.6;
                }
                50% {
                    opacity: 0.8;
                }
                100% {
                    transform: translateY(-100vh) rotate(360deg);
                    opacity: 0;
                }
            }
        `;
        document.head.appendChild(style);
    </script>
</body>

</html>